{
  "name": "actions-pulse",
  "version": "2.0.0",
  "mcpName": "io.github.tsviz/actions-pulse",
  "description": "An Agentic Model Context Protocol (MCP) server for real-time DevOps observability with GitHub Enterprise",
  "main": "dist/index.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsviz/actions-pulse.git"
  },
  "keywords": [
    "mcp",
    "devops",
    "github",
    "enterprise",
    "observability",
    "actions",
    "dora-metrics"
  ],
  "author": "tsviz",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "generate-reports": "echo 'Use the generate_devops_reports tool via MCP or run: npx tsx scripts/generate-reports.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/app": "^14.0.0",
    "@octokit/graphql": "^7.0.0",
    "@octokit/rest": "^20.0.0",
    "@octokit/webhooks": "^12.0.0",
    "date-fns": "^3.0.0",
    "express": "^4.18.0",
    "yaml": "^2.8.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.19.30",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
