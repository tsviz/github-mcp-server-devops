# ActionsPulse MCP Server - Environment Configuration
# Copy this file to .env (or ~/.devops-observer.env) and update with your values

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo (read), actions (read), issues (read/write), pull_requests (read)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Target GitHub organization to monitor
# This is REQUIRED - all API calls will use this organization
# There is no "default" fallback - you must specify your org name
GITHUB_ORG=your-organization

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Path to configuration directory (inside container)
DEVOPS_CONFIG_PATH=/app/config

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Enable Prometheus metrics endpoint
ENABLE_METRICS=true

# Cache TTL for API responses (seconds)
CACHE_TTL_SECONDS=300

# =============================================================================
# METRICS & REPORTING
# =============================================================================

# Enable DORA metrics collection
ENABLE_DORA_METRICS=true

# Production environments to track for deployment metrics
PRODUCTION_ENVIRONMENTS=production,prod

# Reports output directory
REPORTS_OUTPUT_PATH=/app/reports

# =============================================================================
# COMPLIANCE & SECURITY
# =============================================================================

# Default compliance frameworks to check
# Options: SOC2, HIPAA, PCI-DSS, ISO27001, GDPR
DEFAULT_COMPLIANCE_FRAMEWORKS=SOC2

# Enable automatic compliance auditing
AUTO_AUDIT_ENABLED=true

# =============================================================================
# ALERTING THRESHOLDS
# =============================================================================

# Alert when workflow failure rate exceeds this percentage
FAILURE_RATE_THRESHOLD=10

# Alert when job queue time exceeds this (seconds)
QUEUE_TIME_THRESHOLD=300

# Minimum deployments per day before warning
DEPLOYMENT_FREQUENCY_WARNING=1

# =============================================================================
# DEVELOPMENT SETTINGS (Uncomment for debugging)
# =============================================================================

# Enable verbose debug logging
# DEBUG=devops:*

# Enable trace-level operation logging
# TRACE_OPERATIONS=true

# Disable API response caching
# DISABLE_CACHE=true
